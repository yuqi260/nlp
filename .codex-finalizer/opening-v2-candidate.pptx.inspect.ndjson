{"kind":"slide","id":"sl/nfqhwz","slideIndex":5,"layout":{"id":"ly/ux4ruhcv","name":"Title"},"title":"已有研究做到了什么？我们还要做什么？","textShapes":9,"backgroundColor":"rgba(255,255,255,1)"}
{"kind":"textbox","id":"sh/xkne1o3i","slideIndex":5,"position":{"left":58,"top":39,"width":1000,"height":62},"text":"已有研究做到了什么？我们还要做什么？","geometry":"rect","lineWidth":0,"style":{"fontSize":37,"typeface":"微软雅黑","color":"#00539B","bold":true,"alignment":"left"}}
